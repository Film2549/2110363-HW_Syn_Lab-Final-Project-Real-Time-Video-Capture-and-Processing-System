## Basys3 system clock
set_property PACKAGE_PIN W5 [get_ports CLK100MHZ]
set_property IOSTANDARD LVCMOS33 [get_ports CLK100MHZ]
create_clock -name sys_clk -period 10.000 [get_ports CLK100MHZ]
# The 25 MHz VGA/camera XCLK is generated by an MMCM in RTL. Vivado derives
# that generated clock automatically from sys_clk.
# Camera pixel clock is returned by the OV7670 and has board/sensor phase delay,
# so keep it asynchronous to the FPGA-generated clocks.
create_clock -name cam_pclk_clk -period 40.000 [get_ports cam_pclk]
set_clock_groups -asynchronous \
    -group [get_clocks cam_pclk_clk] \
    -group [get_clocks -include_generated_clocks sys_clk]

## Reset button (center)
set_property PACKAGE_PIN U18 [get_ports btnC]
set_property IOSTANDARD LVCMOS33 [get_ports btnC]

## Slide switches
set_property PACKAGE_PIN V17 [get_ports {sw[0]}]
